{
    "name": "meta-leads-poc",
    "version": "0.1.0",
    "description": "Meta Lead Ads PoC",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint src tests --ext .ts"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "express": "^4.18.2",
        "ws": "^8.22.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.0",
        "@types/supertest": "^6.0.2",
        "@types/ws": "^8.18.2",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "eslint": "^8.56.0",
        "prisma": "^5.22.0",
        "supertest": "^6.3.4",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3",
        "vitest": "^1.2.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}